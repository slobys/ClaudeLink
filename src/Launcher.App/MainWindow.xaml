<Window x:Class="Launcher.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Claude Network Launcher" Style="{StaticResource {x:Type Window}}" Width="1160" Height="840" MinWidth="1000" MinHeight="740"
 WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#202C2D" Padding="18,27,18,18">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="9,0,0,30">
     <Border Width="42" Height="42" CornerRadius="12" Background="#D98668" HorizontalAlignment="Left" Margin="0,0,0,14">
      <TextBlock Text="C↗" FontSize="23" FontWeight="SemiBold" Foreground="#202C2D" HorizontalAlignment="Center"/>
     </Border>
     <TextBlock Text="Claude Link" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
     <TextBlock Text="NETWORK LAUNCHER" Foreground="#A8B6B3" FontSize="10" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,0">
     <Border Background="#2E3B3B" CornerRadius="8" Padding="12" Margin="0,0,0,18">
      <StackPanel><TextBlock Text="独立代理内核" Foreground="#DCE6E3" FontSize="12"/>
       <TextBlock Text="sing-box 1.14.4 · x64" Foreground="#A8B6B3" FontSize="11" Margin="0,5,0,0"/></StackPanel>
     </Border>
     <TextBlock Text="v1.1.1   /   本地加密存储" Foreground="#A8B6B3" FontSize="11"/>
    </StackPanel>
    <StackPanel>
     <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="工作台" Tag="Dashboard" Click="Navigate_Click"/>
     <Button x:Name="NavNodes" Style="{StaticResource NavButton}" Content="节点管理" Tag="Nodes" Click="Navigate_Click"/>
     <Button x:Name="NavSubscriptions" Style="{StaticResource NavButton}" Content="订阅管理" Tag="Subscriptions" Click="Navigate_Click"/>
     <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="环境设置" Tag="Settings" Click="Navigate_Click"/>
     <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Content="运行记录" Tag="Logs" Click="Navigate_Click"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,20">
    <StackPanel><TextBlock x:Name="PageTitle" Text="工作台" FontSize="26" FontWeight="SemiBold"/>
     <TextBlock x:Name="PageSubtitle" Text="从节点到 Claude Code，一处准备就绪。" Style="{StaticResource MutedText}" Margin="0,7,0,0"/>
    </StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E7EAE3" CornerRadius="14" Padding="12,7">
     <TextBlock x:Name="ConnectionBadge" Text="●  未连接" Foreground="#4F6258" FontSize="12"/>
    </Border>
   </Grid>
   <StackPanel Grid.Row="1">
    <Border x:Name="UpdateBanner" Visibility="Collapsed" Background="#E7EFE8" BorderBrush="#AFC4B4" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
     <DockPanel>
      <Button x:Name="UpdateActionButton" Content="立即更新" Click="UpdateAction_Click" DockPanel.Dock="Right" Margin="14,0,0,0"/>
      <Button x:Name="UpdateCancelButton" Content="取消下载" Click="CancelUpdate_Click" DockPanel.Dock="Right" Visibility="Collapsed" Margin="14,0,0,0"/>
      <StackPanel><TextBlock x:Name="UpdateBannerText" TextWrapping="Wrap"/><ProgressBar x:Name="UpdateProgress" Height="4" Visibility="Collapsed" Minimum="0" Maximum="100" Margin="0,9,0,0"/></StackPanel>
     </DockPanel>
    </Border>
    <Border x:Name="RecoveryBanner" Visibility="Collapsed" Background="#FFF0DA" BorderBrush="#E1BB7B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
     <DockPanel><Button Content="立即恢复" Click="Restore_Click" DockPanel.Dock="Right" Margin="15,0,0,0"/>
      <TextBlock Text="发现未完成的环境恢复记录，请先恢复后再连接。" TextWrapping="Wrap"/></DockPanel>
    </Border>
    <Border x:Name="ProgressPanel" Visibility="Collapsed" Background="#EEE7DB" CornerRadius="8" Padding="12" Margin="0,0,0,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="ProgressText" Text="正在处理…" FontSize="12"/><ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0" Foreground="#AD4D35"/></StackPanel>
      <Button x:Name="CancelButton" Content="取消检测" Grid.Column="1" Margin="16,0,0,0" Click="Cancel_Click" IsEnabled="False"/>
     </Grid>
    </Border>
   </StackPanel>
   <Grid Grid.Row="2" x:Name="Workspace">
    <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,3,0">
      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="开始一次专注的工作" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="选择节点和项目，启动器会准备网络并打开所选 Claude 应用。" Style="{StaticResource MutedText}" Margin="0,8,0,19"/>
        <TextBlock Text="使用节点" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="NodeCombo" DisplayMemberPath="Display" SelectionChanged="NodeCombo_SelectionChanged" AutomationProperties.Name="使用节点"/>
         <Button Grid.Column="1" Content="添加节点" Margin="10,0,0,0" Click="Import_Click"/>
        </Grid>
        <TextBlock Text="项目文件夹" FontWeight="SemiBold" Margin="0,17,0,7"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <ComboBox x:Name="ProjectBox" IsEditable="True" AutomationProperties.Name="项目文件夹"/>
         <Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="BrowseProject_Click"/>
        </Grid>
        <WrapPanel Margin="0,12,0,14">
         <CheckBox x:Name="TunCheck" Content="TUN 虚拟网卡" ToolTip="连接时请求管理员权限；将全机外网流量交给所选节点，局域网直连。" Margin="0,8,28,8"/>
         <CheckBox x:Name="StrictCheck" Content="沿用 v1.3 严格预检" ToolTip="检查三出口 IPv4 一致、美国地区、TUN、物理网卡 IPv6 和系统时区。" />
        </WrapPanel>
        <WrapPanel>
         <Button x:Name="LaunchButton" Content="准备并打开 Claude 桌面客户端" Style="{StaticResource PrimaryButton}" Click="Launch_Click" Margin="0,0,10,8"/>
         <Button x:Name="ConnectButton" Content="连接并检测" Click="Connect_Click" Margin="0,0,10,8"/>
         <Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click" IsEnabled="False" Margin="0,0,0,8"/>
        </WrapPanel>
        <TextBlock x:Name="ClaudeHint" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
      <UniformGrid Columns="4" Margin="0,16,0,16">
       <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="本地代理" Style="{StaticResource MutedText}"/><TextBlock x:Name="ProxyMetric" Text="未连接" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="连接模式" Style="{StaticResource MutedText}"/><TextBlock x:Name="TunMetric" Text="进程代理" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,10,0"><StackPanel><TextBlock Text="出口地区" Style="{StaticResource MutedText}"/><TextBlock x:Name="ExitMetric" Text="待检测" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}" Padding="15"><StackPanel><TextBlock Text="API 连通性" Style="{StaticResource MutedText}"/><TextBlock x:Name="ApiMetric" Text="待检测" FontSize="15" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}" Padding="20">
       <StackPanel>
        <DockPanel><Button x:Name="BrowserButton" Content="打开专用核对浏览器" Click="Browser_Click" IsEnabled="False" DockPanel.Dock="Right" Padding="12,6"/>
         <TextBlock Text="启动前检查" FontWeight="SemiBold" FontSize="16"/></DockPanel>
        <TextBlock x:Name="CheckSummary" Text="连接后显示检测结果。状态只代表实际测得的内容。" Style="{StaticResource MutedText}" Margin="0,9,0,12"/>
        <ItemsControl x:Name="CheckList">
         <ItemsControl.ItemTemplate><DataTemplate>
          <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <TextBlock Text="{Binding Symbol}" FontSize="16" Foreground="#59665A"/>
           <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"/>
           <StackPanel Grid.Column="2"><TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
          </Grid>
         </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="NodesPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,16">
      <Button Content="添加 / 导入节点" Style="{StaticResource PrimaryButton}" Click="Import_Click" Margin="0,0,9,8"/>
      <Button Content="从剪贴板导入" Click="Paste_Click" Margin="0,0,9,8"/>
      <Button Content="导入文件" Click="ImportFile_Click" Margin="0,0,9,8"/>
      <Button Content="编辑" Click="EditNode_Click" Margin="0,0,9,8"/>
      <Button Content="删除" Click="DeleteNode_Click" Margin="0,0,9,8"/>
      <Button Content="设为当前" Click="SelectNode_Click" Margin="0,0,0,8"/>
     </WrapPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <Grid><DataGrid x:Name="NodesGrid" MouseDoubleClick="SelectNode_Click">
       <DataGrid.Columns>
        <DataGridTextColumn Header="节点名称" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="100"/>
        <DataGridTextColumn Header="服务器" Binding="{Binding Server}" Width="1.4*"/>
        <DataGridTextColumn Header="分组" Binding="{Binding Group}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid><TextBlock x:Name="NodesEmpty" Text="还没有节点&#10;添加分享链接，或前往订阅管理导入订阅。" TextAlignment="Center" Foreground="#69736C" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="26" IsHitTestVisible="False"/></Grid>
     </Border>
     <DockPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="NodeCountText" Style="{StaticResource MutedText}"/><TextBlock Text="双击节点即可选中；连接后请先断开再切换。" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></DockPanel>
    </Grid>
    <Grid x:Name="SubscriptionsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,16">
      <Button Content="添加订阅" Style="{StaticResource PrimaryButton}" Click="AddSubscription_Click" Margin="0,0,9,8"/>
      <Button Content="更新选中" Click="UpdateSubscription_Click" Margin="0,0,9,8"/>
      <Button Content="更新全部" Click="UpdateAllSubscriptions_Click" Margin="0,0,9,8"/>
      <Button Content="编辑" Click="EditSubscription_Click" Margin="0,0,9,8"/>
      <Button Content="删除订阅" Click="DeleteSubscription_Click" Margin="0,0,0,8"/>
     </WrapPanel>
     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <Grid><DataGrid x:Name="SubscriptionsGrid">
       <DataGrid.Columns>
        <DataGridTextColumn Header="订阅名称" Binding="{Binding Name}" Width="1.4*"/>
        <DataGridTextColumn Header="节点" Binding="{Binding Count}" Width="70"/>
        <DataGridTextColumn Header="最近更新" Binding="{Binding Updated}" Width="150"/>
        <DataGridTextColumn Header="流量" Binding="{Binding Usage}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid><TextBlock x:Name="SubscriptionsEmpty" Text="粘贴订阅地址，集中更新你的节点。&#10;失败的更新会保留原有节点。" TextAlignment="Center" Foreground="#69736C" HorizontalAlignment="Center" VerticalAlignment="Center" LineHeight="26" IsHitTestVisible="False"/></Grid>
     </Border>
     <TextBlock Grid.Row="2" Text="订阅地址和节点凭据由当前 Windows 用户加密保存；内容在本机解析。" Style="{StaticResource MutedText}" Margin="0,13,0,0"/>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="连接与进程" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock Text="Claude 启动方式" Margin="0,0,0,7"/>
        <ComboBox x:Name="LaunchTargetCombo" Width="290" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Id" SelectionChanged="LaunchTarget_SelectionChanged" AutomationProperties.Name="Claude 启动方式"/>
        <TextBlock Text="桌面客户端打开官方 Claude 应用的 Code 页面，使用 TUN 网络；命令行模式在独立终端运行。" Style="{StaticResource MutedText}" Margin="0,8,0,17"/>
        <TextBlock Text="本地 HTTP / SOCKS 混合端口" Margin="0,0,0,7"/>
        <TextBox x:Name="PortBox" Width="170" HorizontalAlignment="Left" AutomationProperties.Name="本地代理端口"/>
        <TextBlock Text="仅监听 127.0.0.1；不会修改 Windows 系统代理。" Style="{StaticResource MutedText}" Margin="0,7,0,17"/>
        <TextBlock Text="Claude 桌面客户端路径（留空自动查找，支持商店版）" Margin="0,0,0,7"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="DesktopPathBox" AutomationProperties.Name="Claude 桌面客户端路径"/>
         <Button Grid.Column="1" Content="浏览…" Click="BrowseDesktop_Click" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock Text="Claude Code CLI 路径（仅命令行模式；留空自动查找）" Margin="0,17,0,7"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="ClaudePathBox" AutomationProperties.Name="Claude Code 程序路径"/>
         <Button Grid.Column="1" Content="浏览…" Click="BrowseClaude_Click" Margin="10,0,0,0"/>
        </Grid>
        <TextBlock Text="CLI 与专用核对浏览器语言" Margin="0,17,0,7"/>
        <ComboBox x:Name="LanguageCombo" Width="170" HorizontalAlignment="Left"/>
        <TextBlock Text="专用核对浏览器" Margin="0,17,0,7"/>
        <ComboBox x:Name="BrowserCombo" Width="230" HorizontalAlignment="Left" DisplayMemberPath="Label" SelectedValuePath="Id"/>
        <TextBlock Text="从工作台打开独立浏览器窗口，应用所选语言列表；“语言核对”标签会显示网页实际读取的结果。" Style="{StaticResource MutedText}" Margin="0,9,0,0"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="临时系统环境" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,7"/>
        <CheckBox x:Name="IPv6Check" Content="本次临时关闭活动物理网卡的 IPv6"/>
        <TextBlock Text="需要管理员权限，可能短暂重连；记录原状态，退出时恢复。" Style="{StaticResource MutedText}" Margin="22,0,0,7"/>
        <CheckBox x:Name="TimeZoneCheck" Content="检测出口后，临时匹配 Windows 系统时区"/>
        <TextBlock Text="需要管理员权限，影响整台电脑的时间显示；第三方地区数据无法确认时不修改。" Style="{StaticResource MutedText}" Margin="22,0,0,7"/>
        <Separator Margin="0,14"/>
        <TextBlock Text="严格预检沿用原 v1.3：三出口均为相同 IPv4、参考地区为美国、TUN 已启用、物理网卡 IPv6 已关闭、系统时区匹配。未启用严格预检时，以代理出口和 API 基础连通性为主要结果。" Style="{StaticResource MutedText}"/>
       </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
       <StackPanel>
        <TextBlock Text="软件更新" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <CheckBox x:Name="AutoUpdateCheck" Content="启动时自动检查新版本，有更新时显示按钮"/>
        <TextBlock x:Name="UpdateStatusText" Text="通过 GitHub Releases 获取更新；下载后校验签名和文件完整性。" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
        <WrapPanel><Button x:Name="ManualUpdateButton" Content="检查更新" Click="CheckUpdate_Click" Margin="0,0,10,0"/><Button Content="GitHub 项目与安装包" Click="OpenRepository_Click"/></WrapPanel>
       </StackPanel>
      </Border>
      <WrapPanel>
       <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click" Margin="0,0,10,8"/>
       <Button Content="打开数据文件夹" Click="OpenData_Click" Margin="0,0,10,8"/>
       <Button Content="Claude Code 安装说明" Click="InstallHelp_Click" Margin="0,0,0,8"/>
      </WrapPanel>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="LogsPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,14"><Button Content="清空显示" Click="ClearLogs_Click" DockPanel.Dock="Right"/><TextBlock Text="仅记录操作与结果，不记录订阅地址、密码或完整分享链接。" Style="{StaticResource MutedText}"/></DockPanel>
     <TextBox Grid.Row="1" x:Name="LogBox" FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FCFCF8" Padding="18" AutomationProperties.Name="运行记录"/>
    </Grid>
   </Grid>
   <DockPanel Grid.Row="3" Margin="0,17,0,0">
    <Button Content="恢复临时设置" Click="Restore_Click" DockPanel.Dock="Right" Padding="12,7" MinHeight="32"/>
    <TextBlock x:Name="StatusText" Text="就绪 · 添加节点或订阅即可开始" Style="{StaticResource MutedText}" Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
  </Grid>
 </Grid>
</Window>
