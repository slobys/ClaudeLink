<Window x:Class="Launcher.App.AppDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Claude Link" Style="{StaticResource {x:Type Window}}" Width="600" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
 <Grid Background="{StaticResource Surface}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="26,24,26,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border x:Name="ToneTile" Width="42" Height="42" CornerRadius="10" Background="{StaticResource WarningBg}" VerticalAlignment="Top" Margin="0,0,16,0">
    <Path x:Name="ToneIcon" Data="M10,2 L19,18 L1,18 Z M10,7 L10,11 M10,14 L10,14.5" Stroke="{StaticResource Warning}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform"/>
   </Border>
   <StackPanel Grid.Column="1"><TextBlock x:Name="Heading" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="Introduction" Style="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,0" LineHeight="22"/></StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="1" MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="26,0,26,24" HorizontalScrollBarVisibility="Disabled">
   <StackPanel>
    <Border x:Name="ApiPanel" Visibility="Collapsed" Background="{StaticResource SuccessBg}" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
     <StackPanel><TextBlock x:Name="ApiTitle" FontWeight="SemiBold" Foreground="{StaticResource Success}" TextWrapping="Wrap"/><TextBlock x:Name="ApiDetail" Style="{StaticResource MutedText}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
    </Border>
    <TextBlock x:Name="Message" FontSize="14" TextWrapping="Wrap" LineHeight="23"/>
    <ItemsControl x:Name="Reasons" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{StaticResource WarningBg}" CornerRadius="8" Padding="12,10" Margin="0,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Path Data="M7,1 L13,12 L1,12 Z M7,5 L7,7 M7,9 L7,9.5" Stroke="{StaticResource Warning}" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Top" Margin="0,4,0,0"/>
      <TextBlock Grid.Column="1" Text="{Binding}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" LineHeight="22"/>
     </Grid></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="Footnote" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,17">
   <WrapPanel HorizontalAlignment="Right"><Button x:Name="CancelButton" Content="返回检查" MinWidth="112" IsCancel="True" IsDefault="True" Click="Cancel_Click" Margin="0,0,12,0"/><Button x:Name="ConfirmButton" Content="仍要启动" MinWidth="112" Style="{StaticResource PrimaryButton}" Click="Confirm_Click"/></WrapPanel>
  </Border>
 </Grid>
</Window>
